<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
   <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">

        <h3 class="text-3x1 mb-3"> Create user </h3>
        <form method="post" action="/create">
            <input class="px-3 py-2  rounded-md bg-transparent border-2 border-zinc-8 outline-0" type="text"
                placeholder="username" name="username">

            <input class="px-3 py-2  rounded-md bg-transparent border-2 border-zinc-8 outline-0" type="email"
                placeholder="email" name="email">

            <input class="px-3 py-2  rounded-md bg-transparent border-2 border-zinc-8 outline-0 " type="password"
                placeholder="password" name="password">
                
            <input class="px-3 py-2  rounded-md bg-transparent border-2 border-zinc-8 outline-0" type="number"
                placeholder="age" name="age">

                <input class="px-5 py-2 rounded-md bg-blue-500" type="submit" value="Create User">
            <!-- <input class="px-5 py-2  rounded-md bg-blue-500" type="sumbit" value="Create users"> -->
            <!-- <button class="px-5 py-2 rounded-md bg-blue-500 text-white">Create User</button> -->




        </form>
    </div>

</body>

</html>